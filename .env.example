# Public site URL used for metadata (Open Graph, canonical URLs, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Header / comment-composer avatar after catalog generation.
NEXT_PUBLIC_VIEWER_AVATAR=

# Better Auth (email/password). Secret must be at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only).
# Percent-encode reserved characters in the password (@, /, #, ?, %, *).
DATABASE_URL="postgresql://postgres.rsutxqzehukxxwjuoiwp:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# FAL + Cloudflare used by `npm run db:generate-catalog`.
FAL_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
